# ================================================================
# Docker 部署配置模板
#
# 用法：复制本文件为同目录的 .env.docker，然后只修改 .env.docker。
#   Linux / NAS：cp .env.docker.example .env.docker
#   Windows：    Copy-Item .env.docker.example .env.docker
#
# .env.docker 已被 .gitignore 排除，不会提交到 GitHub。
# 以后更新源码（git pull）只会更新程序文件，不会覆盖本文件。
#
# 下面标有【必须修改】的 3 项必须自己填写，否则 API 会拒绝启动。
# 修改完执行：docker compose --env-file .env.docker up -d --build
# ================================================================

# Docker Compose 项目名称，决定数据卷前缀（默认 order-system_postgres_data）。
# 与 docker-compose.yml 顶部的 name 保持一致；产生数据后不要修改。
COMPOSE_PROJECT_NAME=order-system

# Web 对外监听地址和端口。
# 局域网 / 反向代理：0.0.0.0（默认，局域网可访问）
# 只允许本机访问：127.0.0.1
WEB_BIND_ADDRESS=0.0.0.0
WEB_HOST_PORT=8191

# 浏览器实际访问地址，必须与实际访问方式一致。
# 局域网示例：http://192.168.1.10:8191
# 域名 + HTTPS 示例：https://order.example.com
WEB_ORIGIN=http://localhost:8191

# 首次启动写入数据库的域名白名单，多个域名用英文逗号分隔。
# 只用 IP 访问可以保留 localhost；域名访问必须写你的域名。
INITIAL_ALLOWED_HOSTS=localhost

# ---------------------------------------------------------------
# PostgreSQL 数据库
# ---------------------------------------------------------------

# 数据库名称和账号，可以保留默认值。
POSTGRES_DB=order_system
POSTGRES_USER=order_app

# 【必须修改】数据库密码。
# 只使用字母、数字、点、下划线或短横线，不要保留下面的示例值。
# 已经产生数据后再改这里不会同步修改数据库内部密码。
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# ---------------------------------------------------------------
# API
# ---------------------------------------------------------------

API_PORT=3000

# API 信任的反向代理来源，必须与 docker-compose.yml 中的 Docker 子网一致。
TRUST_PROXY=172.30.0.0/24

# 【必须修改并长期保存】数据加密密钥，至少 32 个字符。
# 用于加密支付宝、银行卡、接口凭证和备份文件；产生数据后不能更换。
# 生成方法：openssl rand -hex 32
DATA_ENCRYPTION_KEY=CHANGE_ME_DATA_ENCRYPTION_KEY_AT_LEAST_32_CHARS

# ---------------------------------------------------------------
# 管理员账号（只在数据库第一次创建管理员时读取）
# ---------------------------------------------------------------

ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=管理员

# 【必须修改】管理员首次登录密码，至少 6 位；登录后可在后台修改。
# 管理员创建成功后，改动这里不再影响数据库中的密码。
ADMIN_INITIAL_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

ADMIN_SESSION_TTL_DAYS=30
ADMIN_SESSION_COOKIE=order_admin_session
ADMIN_ENTRY_TTL_DAYS=30
ADMIN_ENTRY_COOKIE=order_admin_entry
ADMIN_COOKIE_SECURE=auto

# ---------------------------------------------------------------
# 公开链接（在线报单 / 回款登记 / 订单查询）会话
# ---------------------------------------------------------------

EXTERNAL_SESSION_TTL_DAYS=365
EXTERNAL_SESSION_COOKIE=order_external_session
EXTERNAL_COOKIE_SECURE=auto

# ---------------------------------------------------------------
# 以下保持默认即可
# ---------------------------------------------------------------

# 容器内运行状态持久化位置
LOCAL_RUNTIME_STATE_PATH=/var/lib/order-system/runtime-control.json
