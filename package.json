{
  "name": "order-registration-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @order-system/api --filter @order-system/web dev",
    "dev:local": "pglite-server --db=./.local-data/pglite --port=5432 --host=127.0.0.1 --extensions=pgcrypto --max-connections=20 --include-database-url --run \"node scripts/run-local-apps.mjs\"",
    "build": "corepack pnpm -r build",
    "lint": "corepack pnpm -r lint",
    "test": "corepack pnpm -r test",
    "typecheck": "corepack pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@electric-sql/pglite-socket": "0.1.3",
    "prettier": "^3.8.2"
  }
}
