NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
TRUST_PROXY=loopback
INITIAL_ALLOWED_HOSTS=

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres?schema=public&sslmode=disable

# 【开发环境】数据加密密钥；已有加密数据后不要更换。
DATA_ENCRYPTION_KEY=replace_with_a_local_development_encryption_key

ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=管理员
# 【首次启动】管理员初始密码至少 6 个字符；已有管理员后可移除，之后在后台修改。
ADMIN_INITIAL_PASSWORD=replace_with_a_strong_unique_password
ADMIN_SESSION_TTL_DAYS=30
ADMIN_SESSION_COOKIE=order_admin_session
ADMIN_ENTRY_TTL_DAYS=30
ADMIN_ENTRY_COOKIE=order_admin_entry
ADMIN_COOKIE_SECURE=auto

EXTERNAL_SESSION_TTL_DAYS=365
EXTERNAL_SESSION_COOKIE=order_external_session
EXTERNAL_COOKIE_SECURE=auto

LOCAL_RUNTIME_STATE_PATH=.local-data/runtime-control.json
